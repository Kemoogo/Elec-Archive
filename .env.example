# ==============================================================================
# Elec-Archive Production Environment Variables (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# High-entropy secret key used to sign and verify JWT authentication tokens.
# Generate a cryptographically secure 256-bit key using: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB Connection URI inside the container network.
MONGODB_URI=mongodb://mongo:27017/elec-archive

# ------------------------------------------------------------------------------
# 3. WEB SERVER & NGINX SSL REVERSE PROXY
# ------------------------------------------------------------------------------
# HTTP port (redirects automatically to HTTPS).
NGINX_PORT=8080

# HTTPS Encrypted SSL Port (Default: 8443 for rootless Podman, or 443 for root/macvlan).
NGINX_SSL_PORT=8443

# ------------------------------------------------------------------------------
# 4. STORAGE & UPLOADS
# ------------------------------------------------------------------------------
# Absolute storage path for PDF Form 121 and medical records inside the app container.
UPLOAD_PATH=/app/public/uploads

# ------------------------------------------------------------------------------
# 5. APPLICATION BRANDING & RUNTIME
# ------------------------------------------------------------------------------
# Application name displayed across the system.
NEXT_PUBLIC_APP_NAME=الأرشيف الإلكتروني

# Node environment mode
NODE_ENV=production
