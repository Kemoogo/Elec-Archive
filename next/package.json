{
  "name": "next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "mkdir -p .next/standalone/public && cp -r public/. .next/standalone/public/ && mkdir -p .next/standalone/.next/static && cp -r .next/static/. .next/standalone/.next/static/ && node --env-file=.env .next/standalone/server.js",
    "lint": "eslint",
    "test": "npx tsx --test tests/**/*.test.ts",
    "officers:reminder": "npx tsx scripts/officers-rollcall-reminder.ts",
    "seed:officers": "npx tsx --env-file=.env scripts/seed-officers-leaves.ts",
    "seed:officers:clear": "npx tsx --env-file=.env scripts/seed-officers-leaves.ts --clear",
    "seed:large": "npx tsx --env-file=.env scripts/seed-large-data.ts",
    "seed:op": "npx tsx --env-file=.env scripts/seed-operational-data.ts",
    "seed:all": "npx tsx --env-file=.env scripts/seed-large-data.ts && npx tsx --env-file=.env scripts/seed-operational-data.ts && npx tsx --env-file=.env scripts/seed-officers-leaves.ts",
    "db:reset": "npx tsx --env-file=.env scripts/reset-db.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "mongoose": "^9.6.2",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-to-print": "^3.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.41",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "enhanced-resolve": "^5.21.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
